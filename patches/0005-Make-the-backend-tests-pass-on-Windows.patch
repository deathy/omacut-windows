index 3f8b0c37d9b081e9a431b4175834955fa5e5a19e..6a7262b25771d07fe191265ddb9f6efe44318cd3 100644
--- a/tests/omacut_tests.cpp
+++ b/tests/omacut_tests.cpp
@@ -34,6 +34,12 @@
 #include <cstdio>
 #include <memory>
 
+#ifdef Q_OS_WIN
+#include <QUuid>
+#define NOMINMAX
+#include <windows.h>
+#endif

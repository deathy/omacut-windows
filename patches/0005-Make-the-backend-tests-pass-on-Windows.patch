+#ifdef Q_OS_WIN
+    QVERIFY2(pipe.waitUntilOpened(), "ffmpeg opened the pipe");
+#endif
     QTest::qWait(100);
 
     QElapsedTimer elapsed;
@@ -673,6 +762,11 @@ void BackendTests::thumbProviderStopsBlockedJobs() {
 }
 
 void BackendTests::thumbProviderCancelsRunningJobs() {
+#ifdef Q_OS_WIN
+    SilentPipe pipe;
+    QVERIFY(pipe.isValid());
+    const QString video = pipe.name();
+#else
     const QString sleepBin = QStandardPaths::findExecutable(QStringLiteral("sleep"));
     QVERIFY2(!sleepBin.isEmpty(), "sleep is available");
 
@@ -688,14 +782,19 @@ void BackendTests::thumbProviderCancelsRunningJobs() {
 
     EnvVarGuard pathGuard("PATH");
     qputenv("PATH", QFile::encodeName(pathDir.path()));
+    const QString video = QStringLiteral("unused.mp4");
+#endif
 
     // Cancelling a frame that scrolled off screen kills its ffmpeg instead
     // of leaving the worker busy until the extraction would have finished.
     ThumbProvider provider;
-    provider.setVideo(1, QStringLiteral("unused.mp4"));
+    provider.setVideo(1, video);
     std::unique_ptr<QQuickImageResponse> response(
         provider.requestImageResponse(QStringLiteral("1/0"), QSize()));
     QSignalSpy finishedSpy(response.get(), &QQuickImageResponse::finished);
+#ifdef Q_OS_WIN
+    QVERIFY2(pipe.waitUntilOpened(), "ffmpeg opened the pipe");
+#endif
     QTest::qWait(100);
 
     QElapsedTimer elapsed;
@@ -1204,12 +1303,17 @@ void BackendTests::exportStartFailureClearsBusy() {
     QVERIFY(installBrokenFfmpeg(pathDir.path()));
 
     EnvVarGuard pathGuard("PATH");
-    qputenv("PATH", QFile::encodeName(pathDir.path()) + ':' + qgetenv("PATH"));
+    qputenv("PATH", pathPrependedTo(pathDir.path(), qgetenv("PATH")));
 
     backend.exportClips(QUrl::fromLocalFile(m_dir.filePath(QStringLiteral("failed.mp4"))),
                         wholeVideo(1.0));
 
+#ifndef Q_OS_WIN
+    // Unix reports a failed exec asynchronously, so the export is briefly busy.
+    // CreateProcess fails inline instead, which means errorOccurred -- and the
+    // cleanup behind it -- has already run by the time exportClips() returns.
     QVERIFY(backend.busy());
+#endif
     QTRY_COMPARE_WITH_TIMEOUT(failedSpy.count(), 1, 5000);
     QVERIFY(!backend.busy());
     QVERIFY(backend.status().isEmpty());
@@ -1242,7 +1346,7 @@ void BackendTests::failedExportPreservesExistingFile() {
     QVERIFY(installBrokenFfmpeg(pathDir.path()));
 
     EnvVarGuard pathGuard("PATH");
-    qputenv("PATH", QFile::encodeName(pathDir.path()) + ':' + qgetenv("PATH"));
+    qputenv("PATH", pathPrependedTo(pathDir.path(), qgetenv("PATH")));
 
     backend.exportClips(QUrl::fromLocalFile(outPath), wholeVideo(1.0));
     QTRY_COMPARE_WITH_TIMEOUT(failedSpy.count(), 1, 5000);

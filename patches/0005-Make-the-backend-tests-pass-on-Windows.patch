From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Vat <cristian.vat@gmail.com>
Date: Wed, 14 Oct 2026 15:17:11 +0300
Subject: [PATCH] Make the backend tests pass on Windows

Four things stopped them, none of them the code under test:

PATH entries were joined with ':', so the directory holding the
deliberately-broken ffmpeg became part of one nonsense entry and was
never searched. The real ffmpeg ran instead, the export succeeded, and
the two tests waiting for a failure signal waited forever.

The broken ffmpeg was a shebang script named "ffmpeg". Windows finds
executables by extension and starts them with CreateProcess, which knows
nothing about shebangs, so it was neither found nor started. An
"ffmpeg.exe" holding no valid executable image fails to start for the
reason the test actually wants.

The hanging ffmpeg in thumbProviderStopsBlockedJobs and
thumbProviderCancelsRunningJobs, and the slow ffprobe in
probeRunsOffTheUiThread, were shebang scripts too, so on Windows they
never ran. The tests failed, or passed without testing anything, and
only where a "sleep" happened to be on the PATH. There the real tool is
given a named pipe (SilentPipe) for input that never sends a byte, and
each test waits until the tool has opened it, so what it times really
does cut a hang short. The slow ffprobe is held on the pipe for the two
seconds the fake sleeps, then let go by closing it, so the probe fails
as the fake's empty output makes it fail.

And exportStartFailureClearsBusy checked that the export is briefly busy
after a failed start, which holds only where a failed exec is reported
asynchronously. CreateProcess fails inline, so the cleanup has already
run by the time exportClips() returns. The assertions that matter still
run everywhere.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/backend_tests.cpp | 118 +++++++++++++++++++++++++++++++++++++---
 1 file changed, 111 insertions(+), 7 deletions(-)

diff --git a/tests/backend_tests.cpp b/tests/backend_tests.cpp
index 9f1dbe0ce5a08e72d1ae5388f890da8dfc4882a4..0a14b7a8a9e2364286137d89df5f8eee29794478 100644
--- a/tests/backend_tests.cpp
+++ b/tests/backend_tests.cpp
@@ -27,6 +27,12 @@
 
 #include <memory>
 
+#ifdef Q_OS_WIN
+#include <QUuid>
+#define NOMINMAX
+#include <windows.h>
+#endif
+
 #include "backend.h"
 #include "filepicker.h"
 #ifndef OMACUT_NO_PORTAL_PICKER
@@ -377,9 +383,64 @@ QString BackendTests::formatName(const QString &path) const {
     return QString::fromUtf8(proc.readAllStandardOutput()).trimmed();
 }
 
-// Drop an "ffmpeg" into dirPath that always fails to start (its shebang points
-// nowhere), for tests that prepend dirPath to PATH.
+// Join dirPath onto the front of an existing PATH, with whatever separator this
+// platform uses -- ':' on Unix, ';' on Windows.
+static QByteArray pathPrependedTo(const QString &dirPath, const QByteArray &path) {
+    return QFile::encodeName(dirPath) + QDir::listSeparator().toLatin1() + path;
+}
+
+#ifdef Q_OS_WIN
+// Where the tests fake a hung ffmpeg or ffprobe with a shebang script, which
+// Windows cannot start, hang the real tool instead: hand it this named pipe
+// as its input. It accepts the connection and never sends a byte.
+class SilentPipe {
+public:
+    SilentPipe()
+        : m_name(QStringLiteral("\\\\.\\pipe\\omacut-tests-%1")
+                     .arg(QUuid::createUuid().toString(QUuid::WithoutBraces))),
+          m_handle(CreateNamedPipeW(reinterpret_cast<const wchar_t *>(m_name.utf16()),
+                                    PIPE_ACCESS_OUTBOUND, PIPE_TYPE_BYTE | PIPE_WAIT,
+                                    1, 0, 0, 0, nullptr)) {}
+    ~SilentPipe() { close(); }
+    Q_DISABLE_COPY_MOVE(SilentPipe)
+
+    QString name() const { return m_name; }
+    bool isValid() const { return m_handle != INVALID_HANDLE_VALUE; }
+    // A pipe only has a client process once something has opened it. Waiting
+    // for that makes sure a test really cuts short a hang, not a tool that
+    // never got going.
+    bool waitUntilOpened() const {
+        ULONG client = 0;
+        return QTest::qWaitFor([&] { return GetNamedPipeClientProcessId(m_handle, &client) != 0; },
+                               5000);
+    }
+    // Ends the hang: the tool's next read fails, as at the end of a broken file.
+    void close() {
+        if (isValid())
+            CloseHandle(m_handle);
+        m_handle = INVALID_HANDLE_VALUE;
+    }
+
+private:
+    QString m_name;
+    HANDLE m_handle;
+};
+#endif
+
+// Drop an "ffmpeg" into dirPath that always fails to start, for tests that
+// prepend dirPath to PATH.
 bool BackendTests::installBrokenFfmpeg(const QString &dirPath) {
+#ifdef Q_OS_WIN
+    // Windows looks executables up by extension and starts them through
+    // CreateProcess, which has no notion of a shebang. A file named right but
+    // holding no valid executable image is what fails to start here.
+    QFile fake(QDir(dirPath).filePath(QStringLiteral("ffmpeg.exe")));
+    if (!fake.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return false;
+    fake.write("omacut: not an executable image\n");
+    fake.close();
+    return true;
+#else
     QFile fake(QDir(dirPath).filePath(QStringLiteral("ffmpeg")));
     if (!fake.open(QIODevice::WriteOnly | QIODevice::Truncate))
         return false;
@@ -387,6 +448,7 @@ bool BackendTests::installBrokenFfmpeg(const QString &dirPath) {
     fake.close();
     return fake.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner
                                | QFileDevice::ExeOwner);
+#endif
 }
 
 void BackendTests::openDialogDelegatesToFilePicker() {
@@ -589,6 +651,12 @@ void BackendTests::probeRunsOffTheUiThread() {
     // A slow ffprobe (a streamed file with no header duration is the real
     // case) must not freeze the caller: load() accepts, busy() reports the
     // probe in flight, and the refusal arrives later as a signal.
+#ifdef Q_OS_WIN
+    // The real ffprobe, stalled on a pipe until the test lets it fail.
+    SilentPipe pipe;
+    QVERIFY(pipe.isValid());
+    const QUrl url = QUrl::fromLocalFile(pipe.name());
+#else
     const QString sleepBin = QStandardPaths::findExecutable(QStringLiteral("sleep"));
     QVERIFY2(!sleepBin.isEmpty(), "sleep is available");
     QTemporaryDir pathDir;
@@ -602,6 +670,8 @@ void BackendTests::probeRunsOffTheUiThread() {
                                 | QFileDevice::ExeOwner));
     EnvVarGuard pathGuard("PATH");
     qputenv("PATH", QFile::encodeName(pathDir.path()));
+    const QUrl url = videoUrl();
+#endif
 
     ThumbProvider provider;
     Backend backend(&provider, new FakeFilePicker);
@@ -609,10 +679,19 @@ void BackendTests::probeRunsOffTheUiThread() {
 
     QElapsedTimer elapsed;
     elapsed.start();
-    QVERIFY(backend.load(videoUrl()));
+    QVERIFY(backend.load(url));
     QVERIFY2(elapsed.elapsed() < 1000, "load() blocked on ffprobe");
     QVERIFY(backend.busy());
     QVERIFY(backend.source().isEmpty());
+#ifdef Q_OS_WIN
+    // Where the fake sleeps two seconds, hold ffprobe for as long, then let
+    // its read fail.
+    QVERIFY2(pipe.waitUntilOpened(), "ffprobe opened the pipe");
+    QTest::qWait(2000);
+    QVERIFY(backend.busy());
+    QCOMPARE(errorSpy.count(), 0);
+    pipe.close();
+#endif
 
     QTRY_COMPARE_WITH_TIMEOUT(errorSpy.count(), 1, 10000);
     waitForProbe(backend);
@@ -642,6 +721,11 @@ void BackendTests::thumbProviderServesAndCachesFrames() {
 }
 
 void BackendTests::thumbProviderStopsBlockedJobs() {
+#ifdef Q_OS_WIN
+    SilentPipe pipe;
+    QVERIFY(pipe.isValid());
+    const QString video = pipe.name();
+#else
     const QString sleepBin = QStandardPaths::findExecutable(QStringLiteral("sleep"));
     QVERIFY2(!sleepBin.isEmpty(), "sleep is available");
 
@@ -657,12 +741,17 @@ void BackendTests::thumbProviderStopsBlockedJobs() {
 
     EnvVarGuard pathGuard("PATH");
     qputenv("PATH", QFile::encodeName(pathDir.path()));
+    const QString video = QStringLiteral("unused.mp4");
+#endif
 
     // Closing the app mustn't wait on a hung ffmpeg.
     auto provider = std::make_unique<ThumbProvider>();
-    provider->setVideo(1, QStringLiteral("unused.mp4"));
+    provider->setVideo(1, video);
     std::unique_ptr<QQuickImageResponse> response(
